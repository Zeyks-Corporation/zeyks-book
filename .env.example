# PUBLIC / CLIENT SAFE
# LOCAL / STAGING / PRODUCTION
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# Where a deployment reaches the API server. Empty means "same origin", which is
# what the Vercel deployment and the dev proxy both use.
# VITE_PAYMENT_API_URL=https://api.zeyksbook.app

# SERVER SECRETS
# LOCAL / STAGING / PRODUCTION
# The project URL and the publishable key are used to verify caller tokens.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# The secret key is used ONLY by the sign-in code flow: to write the OTP
# challenge row (migration 017) and to mint a one-time token hash once a code is
# verified. It must never appear in a build or a browser bundle.
# SUPABASE_SECRET_KEY=sb_secret_placeholder
# Optional: the key sign-in codes are hashed with. Defaults to SUPABASE_SECRET_KEY.
# Set it separately to be able to rotate one without the other.
# OTP_PEPPER=

# Outbound email (Resend). Without RESEND_API_KEY no sign-in code can be
# delivered: a production deployment refuses the request, and in development the
# code is printed to the server console instead.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=Zeyks Book <signin@zeyksbook.app>
# RESEND_TO_EMAIL=support@zeyksbook.app

# Payments
# PAYMENT_MODE=sandbox
# APP_URL=http://localhost:3000
