# Vercel: add VITE_NEON_URL to Production, Preview, and Development as needed.
# This is a public API endpoint, not a database connection string or password.
VITE_NEON_URL=https://ep-noisy-tree-b3k2y9uq.c-4.ap-southeast-1.aws.neon.tech/neondb

# Optional server API settings. These are server-only: never prefix with VITE_.
# DATABASE_URL is needed for shared API rate limits and Neon-backed payments.
# Obtain the pooled connection string from the Neon Console; do not commit it.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# NEON_AUTH_JWKS_URL is optional; the server derives it from VITE_NEON_URL.

# Optional: enables the contact form on the Vercel API. Keep the real key in
# Vercel Environment Variables; never commit it or prefix it with VITE_.
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=Zeyks Book <contact@zeyksbook.app>
# RESEND_TO_EMAIL=contact@zeyksbook.app

# Leave VITE_PAYMENT_API_URL unset until the optional Neon-backed payment API
# and gateway credentials are configured.
# Google OAuth is configured in Neon Auth, not with a Vercel environment key.
