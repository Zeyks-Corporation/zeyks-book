# ==============================================================================
# Zeyks Book Environment Configuration Template
# Environments: LOCAL, STAGING, PRODUCTION
# ==============================================================================

# PUBLIC / CLIENT SAFE - FIREBASE CONFIGURATION
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# VITE_FIREBASE_APP_ID=your-firebase-app-id
# VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_ALLOW_REMOTE_IN_DEV=yes  # only for deliberate staging work

# SERVER SECRETS
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON=one-line-service-account-json-for-server-only
# Supabase service-role credentials belong only on the server. Rotate any key
# previously committed to source control before setting these values.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-rotated-service-role-key
# SUPABASE_ANON_KEY=your-public-anon-key
# RESEND_API_KEY=re_your_api_key_here
# ESEWA_PRODUCT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=your-esewa-secret-key
# KHALTI_SECRET_KEY=your_khalti_secret_key
# PAYMENT_MODE=sandbox
# APP_URL=https://your-site.example
